{
  "name": "my-ax-agents-hook",
  "main": "src/hook.ts",
  "compatibility_date": "2026-04-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "hooks.ax.cloudflare.dev", "custom_domain": true }],
  "services": [{ "binding": "AGENTS", "service": "my-ax-agents" }]
}
